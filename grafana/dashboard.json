{
    "dashboard": {
      "id": null,
      "uid": "kuma-health-dashboard",
      "title": "Uptime Kuma & Infrastructure Health",
      "tags": ["uptime-kuma", "mariadb", "docker", "safeboard"],
      "timezone": "browser",
      "schemaVersion": 39,
      "version": 1,
      "refresh": "5s",
      "time": {
        "from": "now-15m",
        "to": "now"
      },
      "panels": [
        {
          "id": 1,
          "title": "Uptime Kuma Status",
          "type": "stat",
          "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
          "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
          "targets": [
            {
              "expr": "probe_success{job=\"blackbox-uptime-kuma\"}",
              "refId": "A"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "mappings": [
                {
                  "type": "value",
                  "options": {
                    "0": { "text": "DOWN (ВСЁ ПЛОХО)", "color": "red" },
                    "1": { "text": "UP (OK)", "color": "green" }
                  }
                }
              ],
              "noValue": "DOWN (ВСЁ ПЛОХО)",
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  { "color": "red", "value": null },
                  { "color": "green", "value": 1 }
                ]
              }
            }
          },
          "options": {
            "colorMode": "background",
            "graphMode": "none",
            "textMode": "value"
          }
        },
        {
          "id": 2,
          "title": "MariaDB Database Status",
          "type": "stat",
          "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
          "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
          "targets": [
            {
              "expr": "mysql_up{job=\"mariadb\"}",
              "refId": "A"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "mappings": [
                {
                  "type": "value",
                  "options": {
                    "0": { "text": "DOWN (ВСЁ ПЛОХО)", "color": "red" },
                    "1": { "text": "UP (OK)", "color": "green" }
                  }
                }
              ],
              "noValue": "DOWN (ВСЁ ПЛОХО)",
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  { "color": "red", "value": null },
                  { "color": "green", "value": 1 }
                ]
              }
            }
          },
          "options": {
            "colorMode": "background",
            "graphMode": "none",
            "textMode": "value"
          }
        },
        {
          "id": 3,
          "title": "Uptime Kuma HTTP Latency (ms)",
          "type": "timeseries",
          "gridPos": { "h": 5, "w": 12, "x": 12, "y": 0 },
          "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
          "targets": [
            {
              "expr": "probe_duration_seconds{job=\"blackbox-uptime-kuma\"} * 1000",
              "legendFormat": "HTTP Response Time (ms)",
              "refId": "A"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "ms",
              "custom": { "fillOpacity": 15, "lineWidth": 2 }
            }
          }
        },
        {
          "id": 4,
          "title": "Containers CPU Usage (%)",
          "type": "timeseries",
          "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
          "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
          "targets": [
            {
              "expr": "sum(rate(container_cpu_usage_seconds_total{name=~\"kuma-.*|uptime-kuma\"}[1m])) by (name) * 100",
              "legendFormat": "{{name}}",
              "refId": "A"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "percent",
              "custom": { "fillOpacity": 10, "lineWidth": 2 }
            }
          }
        },
        {
          "id": 5,
          "title": "Containers RAM Usage (MB)",
          "type": "timeseries",
          "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
          "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
          "targets": [
            {
              "expr": "container_memory_working_set_bytes{name=~\"kuma-.*|uptime-kuma\"} / 1024 / 1024",
              "legendFormat": "{{name}}",
              "refId": "A"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "decmbytes",
              "custom": { "fillOpacity": 10, "lineWidth": 2 }
            }
          }
        },
        {
          "id": 6,
          "title": "MariaDB Connections & Host Load",
          "type": "timeseries",
          "gridPos": { "h": 7, "w": 24, "x": 0, "y": 13 },
          "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
          "targets": [
            {
              "expr": "mysql_global_status_threads_connected{job=\"mariadb\"}",
              "legendFormat": "MariaDB Connected Threads",
              "refId": "A"
            },
            {
              "expr": "node_load1{job=\"node-exporter\"}",
              "legendFormat": "Host Load Average (1m)",
              "refId": "B"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "custom": { "fillOpacity": 10, "lineWidth": 2 }
            }
          }
        }
      ]
    },
    "overwrite": true
  }